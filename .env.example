APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://akrag:akrag@localhost:5432/akrag
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_units

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=akrag
MINIO_SECURE=false
# 原文与抽取截图的固定磁盘目录（相对仓库根）。MinIO 不可用时也写这里，重启后仍可读取。
STORAGE_DIR=data/storage

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=knowledge_units

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=akrag-neo4j

# OpenAI-compatible Model Gateway（DashScope compatible-mode 接入千问）。
# 留空 MODEL_API_KEY 时走启发式，不阻塞本地演示。
# 换 embedding 维后必须重建 Qdrant collection，否则 upsert 会因向量维不一致失败。
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=sk-da2098ff387b445c9cbe0b5aa66c2153
MODEL_LLM=qwen-plus
MODEL_VISION=qwen-vl-plus
MODEL_EMBEDDING=text-embedding-v3
MODEL_RERANK=bge-reranker-v2-m3
EMBEDDING_DIM=1024
# 千问 compatible-mode embedding 单次最多 10 条；OpenAI 可调大。
EMBEDDING_BATCH_SIZE=10

DEFAULT_TENANT=default
